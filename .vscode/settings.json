{
  // SQLTools connections to the Docker Postgres (dev-only credentials, same as .env.example)
  "sqltools.connections": [
    {
      "name": "products_db (products)",
      "driver": "PostgreSQL",
      "server": "localhost",
      "port": 5432,
      "database": "products_db",
      "username": "products",
      "password": "products",
      "previewLimit": 50
    },
    {
      "name": "stock_db (stock)",
      "driver": "PostgreSQL",
      "server": "localhost",
      "port": 5432,
      "database": "stock_db",
      "username": "stock",
      "password": "stock",
      "previewLimit": 50
    },
    {
      "name": "postgres (superuser)",
      "driver": "PostgreSQL",
      "server": "localhost",
      "port": 5432,
      "database": "postgres",
      "username": "postgres",
      "password": "postgres",
      "previewLimit": 50
    }
  ]
}
