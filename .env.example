# Copy to .env (cp .env.example .env). Dev-only credentials.

# Postgres superuser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Products service -> products_db
PRODUCTS_DB_USER=products
PRODUCTS_DB_PASSWORD=products

# Stock service -> stock_db
STOCK_DB_USER=stock
STOCK_DB_PASSWORD=stock

# ---- Auth (Keycloak) ----
# Public URL of Keycloak, as browsers and apps see it (through the gateway).
# It is also the token issuer: every service checks `iss` = ${KEYCLOAK_HOSTNAME}/realms/servertest.
KEYCLOAK_HOSTNAME=http://localhost/auth

# Keycloak admin console (http://localhost/auth/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak's own database. Dev: a separate DB + user on the shared Postgres (02-keycloak.sh).
# Production: point KEYCLOAK_DB_URL at a separate Postgres instance; nothing else changes.
KEYCLOAK_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# Client secret of the stock-service client (machine-to-machine). Change it outside dev.
STOCK_CLIENT_SECRET=dev-stock-secret-change-me
